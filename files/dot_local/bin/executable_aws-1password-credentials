#!/usr/bin/env zsh
set -euo pipefail

case "${1:-}" in
  personal)
    account=compound.1password.com
    vault=Private
    item='AWS CLI Access Key'
    key_field='access key id'
    secret_field='secret access key'
    ;;
  togethermade-keys)
    account=togethermade.1password.com
    vault=Employee
    item='TogetherMade AWS IAM access key — JustinW'
    key_field=aws_access_key_id
    secret_field=aws_secret_access_key
    ;;
  *)
    print -u2 'Expected personal or togethermade-keys'
    exit 2
    ;;
esac

op item get "$item" --account "$account" --vault "$vault" --format json |
  jq -ce --arg key "$key_field" --arg secret "$secret_field" '
    def field($label):
      [.fields[] | select(.label == $label) | .value | strings | select(length > 0)]
      | if length == 1 then first else error("Missing or ambiguous credential field") end;
    {Version: 1, AccessKeyId: field($key), SecretAccessKey: field($secret)}
  '
