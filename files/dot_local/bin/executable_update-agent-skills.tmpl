{{- if lookPath "npx" }}
#!/usr/bin/env zsh
#
# Update global agent skills declared in .chezmoidata/skills.yml.
set -euo pipefail

agent_name() {
  case "$1" in
    codex)
      print -- "codex"
      ;;
    copilot)
      print -- "github-copilot"
      ;;
    claude)
      print -- "claude-code"
      ;;
    *)
      return 1
      ;;
  esac
}

agents=(
  {{- range $agent := .skills.global.agents }}
  "{{ $agent }}"
  {{- end }}
)

skills=(
  {{- range $skill := .skills.global.entries }}
  "{{ $skill.source }}"
  "{{ $skill.skill }}"
  {{- end }}
)

if (( ${#skills[@]} == 0 )); then
  print -- "No global agent skills are configured."
  exit 0
fi

for (( index = 1; index <= ${#skills[@]}; index += 2 )); do
  source="${skills[$index]}"
  name="${skills[$(( index + 1 ))]}"

  arguments=(npx --yes skills add "$source" --skill "$name" --global --yes)
  for agent in "${agents[@]}"; do
    cli_agent="$(agent_name "$agent")" || {
      print -u2 -- "Unsupported global skill agent: $agent"
      exit 1
    }
    arguments+=(--agent "$cli_agent")
  done

  print -- "Updating $name from $source for ${agents[*]}"
  "${arguments[@]}"
done
{{- end }}
