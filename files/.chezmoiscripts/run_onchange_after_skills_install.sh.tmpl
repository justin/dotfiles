{{ if and (not .headless) (lookPath "npx") -}}
#!/usr/bin/env zsh
#
# Install global agent skills declared in .chezmoidata/skills.yml via the `skills` CLI.
set -euo pipefail

source {{ joinPath .chezmoi.sourceDir "functions/_logging" }}
source {{ joinPath .chezmoi.sourceDir "functions/_utilities" }}

had_error=0

agent_name() {
  case "$1" in
    codex)
      printf '%s\n' "codex"
      ;;
    copilot)
      printf '%s\n' "github-copilot"
      ;;
    claude)
      printf '%s\n' "claude-code"
      ;;
    *)
      return 1
      ;;
  esac
}

agents=(
  {{- range $agent := .skills.global.agents }}
  "{{ $agent }}"
  {{- end }}
)

skill_entries=(
  {{- range $skill := .skills.global.entries }}
  "{{ $skill.source }}:::{{- with index $skill "skill" }}{{ . }}{{- end }}"
  {{- end }}
)

processing "Reconciling global agent skills..."
for entry in "${skill_entries[@]}"; do
  source="${entry%%:::*}"
  name="${entry#*:::}"

  arguments=(npx --yes skills add "$source" --global --yes)
  if [[ -n "$name" ]]; then
    arguments+=(--skill "$name")
    description="skill $name"
  else
    description="all skills"
  fi
  for agent in "${agents[@]}"; do
    cli_agent="$(agent_name "$agent")" || {
      warning "Unsupported global skill agent: $agent"
      had_error=1
      continue 2
    }
    arguments+=(--agent "$cli_agent")
  done

  output_file="$(mktemp "${TMPDIR:-/tmp}/run-onchange-skills.XXXXXX")"
  if "${arguments[@]}" >"$output_file" 2>&1; then
    if ! rg -iq "already (installed|exists)|up[ -]?to[ -]?date|no changes?" "$output_file"; then
      success "Updated $description from $source"
      if [[ "${UPDATE_AGENT_SKILLS_VERBOSE:-0}" == "1" ]] && [[ -s "$output_file" ]]; then
        cat "$output_file"
      fi
    fi
  else
    warning "Failed to install $description"
    cat "$output_file" >&2
    had_error=1
  fi
  rm -f "$output_file"
done

if (( had_error )); then
  warning "Skill installation completed with errors"
  exit 1
else
  success "Skill installation complete"
  exit 0
fi
{{ end -}}
