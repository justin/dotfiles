{
  "cleanupPeriodDays": 99999,
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Edit(**/.env.example)",
      "Edit(**/.env.sample)",
      "Edit(**/.env.template)",
      "Bash(aws configure list-profiles *)",
      "Bash(aws ecs describe-services *)",
      "Bash(aws ecs describe-task-definition *)",
      "Bash(aws logs filter-log-events *)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(chezmoi diff *)",
      "Bash(defaults read *)",
      "Bash(df *)",
      "Bash(docker image ls *)",
      "Bash(docker images *)",
      "Bash(docker info)",
      "Bash(docker inspect *)",
      "Bash(docker logs *)",
      "Bash(docker ps *)",
      "Bash(ffprobe *)",
      "Bash(gh auth status)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(lsof *)",
      "Bash(mdfind *)",
      "Bash(mkdir *)",
      "Bash(nl *)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(shasum *)",
      "Bash(sleep *)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(swiftlint *)",
      "Bash(touch *)",
      "Bash(xcbeautify *)",
      "Bash(xmllint *)"
    ],
    "ask": [
      "Bash(aws configure export-credentials *)",
      "Bash(aws ecs deregister-task-definition *)",
      "Bash(aws ecs tag-resource *)",
      "Bash(aws login *)",
      "Bash(aws s3 cp *)",
      "Bash(aws s3api delete-objects *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh repo create *)",
      "Bash(gh workflow run *)",
      "Bash(just deploy-nas *)",
      "Bash(op document *)",
      "Bash(op item *)",
      "Bash(op read *)",
      "Bash(op signin *)",
      "Bash(scp *)",
      "Bash(sudo *)",
      "Bash(terraform *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.dev)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(.env.staging)",
      "Read(.env.prod)",
      "Read(.env.production)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Trusted SSH hosts (ssh-config aliases): nas, homelab. Justin's own NAS (Clickwheel music server) and homelab.",
      "Trusted internal domains: music.748sj.co, music-staging.748sj.co, lidarr.748sj.co. Justin's own self-hosted services.",
      "Trusted staging domains: api-staging.together-made.com, app-staging.together-made.com, admin-staging.together-made.com. togetherMade staging only; production hosts are not trusted."
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
  "editorMode": "vim"
}
