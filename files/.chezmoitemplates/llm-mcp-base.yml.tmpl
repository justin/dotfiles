# Canonical MCP server definitions shared across LLM tool configs.
# tools: chezmoi-managed clients that consume this server (claude, codex, copilot)
# platforms: chezmoi.os values this server applies to
servers:
  openaiDeveloperDocs:
    type: url
    url: https://developers.openai.com/mcp
    tools: [codex]
    platforms: [darwin, linux]

  svelte:
    type: url
    url: https://mcp.svelte.dev/mcp
    tools: [claude, copilot]
    platforms: [darwin, linux]

  xcodebuildmcp:
    command: npx
    args: [-y, xcodebuildmcp@latest, mcp]
    enabled: true
    tools: []
    platforms: [darwin]

  1password:
    command: 1password-mcp
    enabled: true
    tools: []
    platforms: [darwin]

  playwright:
    command: npx
    args: ["@playwright/mcp@latest"]
    tools: []
    platforms: [darwin]

  applemusic:
    # Absolute path required: Claude Desktop spawns MCP servers with the
    # minimal launchd PATH, which doesn't include the uv tool bin dir
    # (~/.local/bin) where `uv tool install` places this shim.
    command: /Users/justinwilliams/.local/bin/applemusic-mcp
    args: ["serve"]
    enabled: true
    tools: [claude]
    platforms: [darwin]

  semble:
    command: uvx
    args: [--from, "semble[mcp]", semble, --content, all]
    enabled: true
    tools: [claude, codex]
    platforms: [darwin]
