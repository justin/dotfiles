{{- /* Merges the canonical MCP servers tagged for "claude" over a live
       Claude Code *.claude.json (passed in on .chezmoi.stdin). Every other
       key in the file is Claude Code's own runtime state (auth, caches,
       sessions, project history) and passes through untouched. Shared by
       every *.claude.json this repo manages (the home ~/.claude.json and
       Xcode's ClaudeAgentConfig/.claude.json).

       mcpServers gets reconciliation, not a plain merge: any existing entry
       whose name is STILL PRESENT in llm-mcp-base.yml.tmpl is fully owned, so
       removing "claude" from its tags deletes it here too. Entries Claude
       Code itself might inject under a name we've never declared would pass
       through untouched (none exist today). Caveat: deleting a server's
       entire entry from llm-mcp-base.yml.tmpl (not just untagging it) makes
       it indistinguishable from an app-injected key, so it will NOT be
       auto-removed from files this has already applied to — untag first
       (empty its "tools" list) to let this delete it, then remove the entry
       once no live file still has it. */ -}}
{{- $tool := "claude" -}}
{{- $base := (include (joinPath .chezmoi.sourceDir ".chezmoitemplates/llm-mcp-base.yml.tmpl") | fromYaml).servers -}}
{{- $knownNames := keys $base -}}
{{- $mcpServers := dict -}}
{{- range $name, $def := $base -}}
  {{- if has $tool $def.tools -}}
    {{- $server := omit $def "tools" "platforms" -}}
    {{- if and (hasKey $server "type") (eq (index $server "type") "url") -}}
      {{- $server = set $server "type" "http" -}}
    {{- end -}}
    {{- $mcpServers = set $mcpServers $name $server -}}
  {{- end -}}
{{- end -}}
{{- $existing := dict -}}
{{- if .chezmoi.stdin -}}
  {{- $existing = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- $reconciled := dict -}}
{{- if hasKey $existing "mcpServers" -}}
  {{- range $name, $def := (index $existing "mcpServers") -}}
    {{- if not (has $name $knownNames) -}}
      {{- $reconciled = set $reconciled $name $def -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $name, $def := $mcpServers -}}
  {{- $reconciled = set $reconciled $name $def -}}
{{- end -}}
{{- $existing = set $existing "mcpServers" $reconciled -}}
{{- $existing | toPrettyJson -}}
